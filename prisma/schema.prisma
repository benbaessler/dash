// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  fid String @id @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  signerUuid String
  publicKey String
  shared Share[] @relation("shared")

  @@index([fid])
}

model Share {
  id Int @id @default(autoincrement())
  senderFid String
  recipientFid String
  count Int @default(1)
  
  sender User @relation("shared", fields: [senderFid], references: [fid])

  @@unique([senderFid, recipientFid])
  @@index([senderFid])
  @@index([recipientFid])
}

