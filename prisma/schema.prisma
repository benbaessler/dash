generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  fid        String   @id @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  signerUuid String
  publicKey  String

  @@index([fid])
}

model View {
  id        Int      @id @default(autoincrement())
  castHash  String
  channelId String?
  createdAt DateTime @default(now())
  fid       String

  @@unique([fid, castHash])
  @@index([fid, channelId])
  @@index([castHash])
}

model Share {
  id           Int      @id @default(autoincrement())
  senderFid    String
  recipientFid String
  updatedAt    DateTime @updatedAt

  @@unique([senderFid, recipientFid])
  @@index([senderFid])
}

model Search {
  id          Int      @id @default(autoincrement())
  searcherFid String
  queryId     String
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}
