# App
NEXT_PUBLIC_URL='http://localhost:3000'
NEXT_PUBLIC_DOMAIN="localhost:3000"
NEXT_PUBLIC_FRAME_NAME="Dash"
NEXT_PUBLIC_FRAME_DESCRIPTION="Short-form video app for Farcaster"
NEXT_PUBLIC_FRAME_BUTTON_TEXT="Watch"
NEXT_PUBLIC_PROMOTION_PAGE_INDEX=10

# Database (PostgreSQL)
DATABASE_URL=""

# Upstash Redis (optional, falls back to in-memory storage)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Neynar
NEYNAR_API_KEY=""
NEYNAR_CLIENT_ID=""

# App account used to sign signer key requests
FARCASTER_DEVELOPER_MNEMONIC=""
# Signer of the account that owns the channel new users are invited to
DEV_SIGNER_UUID=""

# Feed (mbd.xyz)
MBD_API_KEY=""

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=""

# Mini app manifest account association (generate in the Farcaster developer tools)
ACCOUNT_ASSOCIATION_HEADER=""
ACCOUNT_ASSOCIATION_PAYLOAD=""
ACCOUNT_ASSOCIATION_SIGNATURE=""

# Development
VERCEL_ENV="development"
NEXT_PUBLIC_VERCEL_ENV="development"
# FID used to personalize the feed in development
NEXT_PUBLIC_DEV_FID=""
